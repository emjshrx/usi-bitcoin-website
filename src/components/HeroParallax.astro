---
import { withBase } from "../utils/withBase";
import HeroStats from "./HeroStats.astro";
import type { SiteData } from "../data/siteData";

interface Props {
  site: SiteData;
  lang: "it" | "en";
}

const { site, lang } = Astro.props;
const asset = withBase;
const { join, hero } = site;

const heroImages = site.images.hero;
const showRegisterButton = Boolean(join.joinUrl?.trim());
const joinBtnClass =
  "inline-flex min-h-[44px] w-fit items-center justify-center rounded-xl bg-orange-500 px-6 py-3 text-sm font-bold text-white transition hover:bg-orange-600 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-orange-500";
---

<section
  id="hero"
  class="relative flex min-h-[125svh] flex-col overflow-hidden"
  aria-label={site.brand.title}
>
  <div data-parallax data-speed="0.05" class="hero-layer z-[1]" aria-hidden="true">
    <img src={asset(heroImages.sky)} alt="" fetchpriority="high" loading="eager" />
  </div>
  <div data-parallax data-speed="0.22" class="hero-layer z-[2]" aria-hidden="true">
    <img src={asset(heroImages.hillsLake)} alt="" loading="eager" />
  </div>

  <div class="absolute inset-0 z-[4] bg-black/35 pointer-events-none" aria-hidden="true"></div>

  <div class="relative z-10 flex min-h-0 flex-1 flex-col pointer-events-none">
    <div
      data-parallax
      data-speed="0.2"
      class="flex flex-1 items-start justify-center px-6 pt-6 md:items-center md:px-16 md:pt-0"
    >
      <div
        class:list={[
          "hero-copy pointer-events-auto flex w-full max-w-6xl flex-col items-center text-center text-white",
          showRegisterButton && "hero-copy--with-cta",
          "hero-copy--with-stats",
        ]}
      >
        <h1 class="text-6xl font-medium uppercase leading-none tracking-tight text-white drop-shadow-xl md:text-8xl lg:text-9xl">
          {site.brand.title}
        </h1>
        <p class="mt-4 text-base font-bold tracking-wide text-orange-300 drop-shadow md:text-lg">
          {hero.tagline}
        </p>
        <p class="mt-6 max-w-2xl whitespace-pre-line text-base font-normal leading-relaxed text-white/95 drop-shadow md:mt-8 md:text-lg">
          {hero.description}
        </p>
        {
          showRegisterButton && (
            <a href={join.joinUrl} class:list={["mt-6", joinBtnClass]} rel="noopener noreferrer">
              {join.joinButtonLabel}
            </a>
          )
        }
        <HeroStats site={site} />
      </div>
    </div>

    <div class="pointer-events-auto mt-auto shrink-0">
      <slot />
    </div>
  </div>
</section>

<style>
  .hero-copy {
    --hero-below-title: 0;
    transform: none;
  }

  @media (min-width: 768px) {
    .hero-copy {
      --hero-below-title: 3.75rem;
      transform: translateY(calc(var(--hero-below-title) / 2 + 0.75rem));
    }

    .hero-copy--with-cta {
      --hero-below-title: 11rem;
    }

    .hero-copy--with-stats {
      --hero-below-title: 8rem;
    }

    .hero-copy--with-cta.hero-copy--with-stats {
      --hero-below-title: 15.5rem;
    }
  }

  .hero-layer {
    position: absolute;
    inset: -10% 0;
    will-change: transform;
  }
  .hero-layer img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center bottom;
  }
</style>
