---
import Layout from "../layouts/Layout.astro";
import HeroParallax from "./HeroParallax.astro";
import SocialIconLink from "./SocialIconLink.astro";
import SiteHeader from "./SiteHeader.astro";
import { withBase } from "../utils/withBase";
import type { SiteData } from "../data/siteData";

interface Props {
  site: SiteData;
  lang: "it" | "en";
}

const { site, lang } = Astro.props;
const asset = withBase;
const en = lang === "en";

const {
  brand,
  report,
  cosaFacciamo,
  chiSiamo,
  missione,
  visione,
  join,
  social,
  joinTeam,
  partners,
  team,
  seo,
  ui,
} = site;

const showReport = Boolean(report.url?.trim());
const showJoinBlock = Boolean(join.joinUrl?.trim());
const showJoinTeam = Boolean(joinTeam.url?.trim());
const joinAndReportTwoCol = showJoinBlock && showReport;
const showCTASection = showJoinBlock || showReport || showJoinTeam;
const ctaThreeCol = showJoinBlock && showJoinTeam && showReport;
const showCosaFacciamo = cosaFacciamo.events.length > 0 || Boolean(cosaFacciamo.intro?.trim());
const showPartners = partners.items.length > 0;
const showTeam = team.members.length > 0;

// Repeat enough times that the marquee is always "full" even with few partners.
// Target ~16 items minimum (tuned by eye); clamp to at least 4 repeats.
const partnerReps = showPartners ? Math.max(4, Math.ceil(16 / partners.items.length)) : 0;

// Filter out YouTube from social links
const filteredSocialLinks = social.links.filter(
  (link) => !link.label.toLowerCase().includes("youtube") && !link.url?.toLowerCase().includes("youtube")
);

const joinTeamBtnClass =
  "inline-flex min-h-[44px] w-fit items-center justify-center rounded-none bg-orange-500 px-6 py-3 text-sm font-bold text-white transition hover:bg-orange-600 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-orange-500";

const missionWaysBackdropUrl = asset("/images/Gemini_Generated_Image_cxzycgcxzycgcxzy.png");
---

<Layout title={brand.title} description={seo.description} lang={lang}>

  <SiteHeader site={site} lang={lang} showTeam={showTeam} showPartners={showPartners} />

  <!-- ═══ HERO ════════════════════════════════════════════════════════════ -->
  <HeroParallax site={site} lang={lang}>
    {showPartners && (
      <div
        id="partner"
        class="relative z-20 mt-auto pb-6"
        aria-label={partners.sectionTitle}
      >
        <div class="w-full">
          <div class="partner-carousel">
            <div class="partner-carousel__viewport" role="region" aria-label={partners.sectionTitle}>
              <ul class="partner-carousel__track px-4 md:px-8" aria-label={partners.sectionTitle}>
                {Array.from({ length: partnerReps }).map((_, repIdx) =>
                  partners.items.map((p) => (
                    <li class="partner-carousel__item" aria-hidden={repIdx > 0 ? "true" : undefined}>
                      {p.logo?.trim() ? (
                        p.url?.trim() ? (
                          <a
                            href={p.url}
                            target="_blank"
                            rel="noopener noreferrer"
                            aria-label={p.name}
                            tabIndex={repIdx > 0 ? -1 : undefined}
                          >
                            <img
                              src={asset(p.logo.trim())}
                              alt={repIdx > 0 ? "" : p.name}
                              class="h-9 w-auto max-w-full object-contain brightness-0 invert opacity-80 transition hover:opacity-100"
                              loading="lazy"
                            />
                          </a>
                        ) : (
                          <img
                            src={asset(p.logo.trim())}
                            alt={repIdx > 0 ? "" : p.name}
                            class="h-9 w-auto max-w-full object-contain brightness-0 invert opacity-80"
                            loading="lazy"
                          />
                        )
                      ) : (
                        p.url?.trim() ? (
                          <a
                            href={p.url}
                            class="text-sm font-semibold text-white/80 hover:text-white"
                            target="_blank"
                            rel="noopener noreferrer"
                            tabIndex={repIdx > 0 ? -1 : undefined}
                            aria-hidden={repIdx > 0 ? "true" : undefined}
                          >
                            {p.name}
                          </a>
                        ) : (
                          <span class="text-sm font-semibold text-white/80" aria-hidden={repIdx > 0 ? "true" : undefined}>
                            {p.name}
                          </span>
                        )
                      )}
                    </li>
                  ))
                )}
              </ul>
            </div>
          </div>
        </div>
      </div>
    )}
  </HeroParallax>

  <style>
    .partner-carousel__viewport {
      position: relative;
      overflow: hidden;
    }

    .partner-carousel__track {
      display: flex;
      align-items: center;
      width: max-content;
      gap: 14px;
      will-change: transform;
      animation: partner-marquee 28s linear infinite;
      padding: 6px 2px;
    }

    .partner-carousel__item {
      flex: 0 0 auto;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      padding: 10px 6px;
      white-space: nowrap;
    }

    .partner-carousel:hover .partner-carousel__track {
      animation-play-state: paused;
    }

    @keyframes partner-marquee {
      from {
        transform: translate3d(0, 0, 0);
      }
      to {
        transform: translate3d(-50%, 0, 0);
      }
    }

    @media (prefers-reduced-motion: reduce) {
      .partner-carousel__track {
        animation: none;
        overflow-x: auto;
        scroll-snap-type: x mandatory;
        padding-bottom: 10px;
      }
      .partner-carousel__track > li {
        scroll-snap-align: start;
      }
      .partner-carousel:hover .partner-carousel__track {
        animation-play-state: running;
      }
    }
  </style>

  <!-- ═══ LIGHT SECTION ═══════════════════════════════════════════════════ -->
  <div class="bg-white">

    <!-- CHI SIAMO + MISSIONE + VISIONE — merged ──────────────────────── -->
    <section id="chi-siamo" class="scroll-mt-24 px-4 py-20 md:px-8 md:scroll-mt-28">
      <div class="mx-auto grid max-w-6xl gap-10 md:grid-cols-2 md:items-start md:gap-12 lg:gap-14">
        <div class="min-w-0">
          <h2 class="mb-8 text-3xl font-black tracking-tight text-ink md:text-4xl">
            {chiSiamo.title}
          </h2>
          <p class="text-lg leading-relaxed text-ink/70">
            {chiSiamo.body} {missione.body} {visione.body}
          </p>
        </div>
        <div class="min-w-0 flex justify-center md:justify-end">
          <img
            src={asset("/images/Gemini_Generated_Image_rmes4mrmes4mrmes.png")}
            alt=""
            class="h-auto w-full max-w-xl rounded-xl shadow-card md:max-w-none"
            loading="lazy"
            decoding="async"
          />
        </div>
      </div>
    </section>

    <!-- COSA FACCIAMO ────────────────────────────────────────────────── -->
    {showCosaFacciamo && (
      <section id="cosa-facciamo" class="scroll-mt-24 bg-gray-50 px-4 py-20 md:px-8 md:scroll-mt-28">
        <div class="mx-auto max-w-6xl">
          <h2 class="mb-12 text-3xl font-black tracking-tight text-ink md:text-4xl">
            {cosaFacciamo.sectionTitle}
          </h2>
          {cosaFacciamo.intro && (
            <p class="mb-10 max-w-2xl text-sm text-ink/60">{cosaFacciamo.intro}</p>
          )}
          {cosaFacciamo.events.length > 0 && (
            <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
              {cosaFacciamo.events.map((ev) => (
                <article class="flex flex-col overflow-hidden rounded-xl bg-white shadow-card">
                  {ev.image?.trim() ? (
                    <img
                      src={asset(ev.image.trim())}
                      alt=""
                      width="480"
                      height="270"
                      class="aspect-video w-full object-cover"
                      loading="lazy"
                    />
                  ) : (
                    <div class="aspect-video w-full bg-slate-800 flex items-center justify-center" aria-hidden="true">
                      <span class="text-white/10 text-5xl font-black">₿</span>
                    </div>
                  )}
                  <div class="flex flex-1 flex-col p-5">
                    <p class="font-bold text-ink">{ev.title}</p>
                    {ev.date && <p class="mt-1 text-xs text-ink/45">{ev.date}</p>}
                    {ev.description && (
                      <p class="mt-2 flex-1 text-[0.85rem] leading-relaxed text-ink/70">{ev.description}</p>
                    )}
                    <span class="mt-4 text-sm font-bold text-orange-500">
                      {en ? "Learn more →" : "Scopri di più →"}
                    </span>
                  </div>
                </article>
              ))}
            </div>
          )}
        </div>
      </section>
    )}

  </div><!-- /light section -->

  <!-- ═══ DARK SECTION ════════════════════════════════════════════════════ -->
  <div class="bg-black text-white">

    <!-- Mission + ways: blurred photographic backdrop ───────────────────── -->
    <div class="relative overflow-hidden bg-black">
      <div class="pointer-events-none absolute inset-0 z-0" aria-hidden="true">
        <div
          class="absolute inset-[-28%] bg-cover bg-center"
          style={{
            backgroundImage: `url('${missionWaysBackdropUrl}')`,
            filter: "blur(110px)",
            WebkitFilter: "blur(110px)",
          }}
        />
      </div>
      <div class="pointer-events-none absolute inset-0 z-[1] bg-black/72" aria-hidden="true" />

      <!-- MISSION QUOTE ──────────────────────────────────────────────────── -->
      <section class="relative z-[2] px-6 py-24 md:px-16">
        <div class="mx-auto max-w-4xl">
          <blockquote class="text-2xl font-bold italic leading-snug text-white/85 md:text-4xl">
            &ldquo;{missione.body}&rdquo;
          </blockquote>
        </div>
      </section>

      <!-- WAYS WE DO COMMUNITY ────────────────────────────────────────────── -->
      {showCosaFacciamo && cosaFacciamo.events.length > 0 && (
        <section class="relative z-[2] px-4 pb-16 md:px-8 md:pb-24">
          <div class="mx-auto max-w-6xl">
            <h2 class="mb-12 text-4xl font-black uppercase leading-tight tracking-tight text-white md:text-6xl">
              {en
                ? <><span>WAYS </span><span class="bg-white px-2 text-black">[WE DO]</span><span> COMMUNITY</span></>
                : <><span>COME </span><span class="bg-white px-2 text-black">[FACCIAMO]</span><span> COMUNITÀ</span></>}
            </h2>
            <div class="grid gap-5 sm:grid-cols-2">
              {cosaFacciamo.events.map((ev) => (
                <article class="flex flex-col rounded-xl border border-white/10 bg-white/5 p-6 transition hover:border-white/50">
                  <span class="mb-4 inline-block self-start rounded-full bg-white px-3 py-1 text-xs font-bold uppercase tracking-widest text-black">
                    {ev.title}
                  </span>
                  {ev.date && <p class="mb-2 text-xs text-white/40">{ev.date}</p>}
                  {ev.description && (
                    <p class="flex-1 text-[0.9rem] leading-relaxed text-white/65">{ev.description}</p>
                  )}
                  <span class="mt-5 text-sm font-bold text-white">
                    {en ? "Learn More →" : "Scopri →"}
                  </span>
                </article>
              ))}
            </div>
          </div>
        </section>
      )}
    </div>

    <!-- REPORT ───────────────────────────────────────────────────────── -->
    {showReport && (
      <section
        id="report"
        class="scroll-mt-24 bg-gray-50 px-4 py-20 text-ink md:px-8 md:scroll-mt-28"
      >
        <div class="mx-auto grid max-w-6xl gap-10 md:grid-cols-2 md:items-center md:gap-12 lg:gap-14">
          {report.coverImage?.trim() && (
            <div class="min-w-0 flex justify-center md:justify-start">
              <img
                src={asset(report.coverImage.trim())}
                alt={ui.reportCoverAlt}
                class="aspect-square w-full max-w-xs rounded-xl object-cover shadow-card md:max-w-sm"
                loading="lazy"
                decoding="async"
              />
            </div>
          )}
          <div class="min-w-0 flex flex-col items-center text-center md:items-start md:text-left">
            <h2 class="mb-8 text-3xl font-black tracking-tight text-ink md:text-4xl">
              {report.sectionTitle}
            </h2>
            {report.description && (
              <p class="mb-10 max-w-2xl text-lg leading-relaxed text-ink/70">{report.description}</p>
            )}
            <a
              href={report.url}
              class="inline-flex min-h-[44px] w-fit items-center justify-center rounded-none bg-orange-500 px-6 py-3 text-sm font-bold text-white transition hover:bg-orange-600 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-orange-500"
              target="_blank"
              rel="noopener noreferrer"
            >
              {report.buttonLabel}
            </a>
          </div>
        </div>
      </section>
    )}

    <!-- TEAM ─────────────────────────────────────────────────────────── -->
    {showTeam && (
      <section
        id="team"
        class="scroll-mt-24 bg-white px-4 py-20 text-ink md:px-8 md:scroll-mt-28"
      >
        <div class="mx-auto max-w-6xl">
          <h2 class="mb-4 text-3xl font-black tracking-tight md:text-4xl">
            {team.sectionTitle}
          </h2>
          {team.intro && (
            <p class="mb-12 max-w-2xl text-sm text-ink/55">{team.intro}</p>
          )}
          <ul class="grid grid-cols-2 gap-5 sm:grid-cols-3 md:grid-cols-6">
            {team.members.map((m) => (
              <li class="flex flex-col items-center rounded-xl border border-ink/10 bg-gray-50 p-5 text-center">
                {m.photo?.trim() ? (
                  <span class="mb-3 inline-flex h-16 w-16 shrink-0 isolate overflow-hidden rounded-lg bg-[hsl(24,48%,52%)]">
                    <img
                      src={asset(m.photo.trim())}
                      alt=""
                      width="120"
                      height="120"
                      class="h-full w-full object-cover grayscale contrast-[1.35] brightness-[0.82] mix-blend-luminosity"
                      loading="lazy"
                      decoding="async"
                    />
                  </span>
                ) : (
                  <div
                    class="mb-3 flex aspect-square h-16 w-16 shrink-0 items-center justify-center rounded-lg bg-ink/10 text-sm font-bold text-ink/40"
                    aria-hidden="true"
                  >
                    {m.name.split(/\s+/).map((w: string) => w[0]).join("").slice(0, 2).toUpperCase()}
                  </div>
                )}
                <p class="text-sm font-bold leading-tight text-ink">{m.name}</p>
                {m.role && <p class="mt-1 text-xs text-ink/55">{m.role}</p>}
                {m.linkedinUrl?.trim() && (
                  <a
                    href={m.linkedinUrl.trim()}
                    class="mt-2 text-xs font-semibold text-orange-500 underline underline-offset-2 hover:text-orange-600"
                    target="_blank"
                    rel="noopener noreferrer"
                  >
                    {ui.linkedinLabel}
                  </a>
                )}
              </li>
            ))}
          </ul>
        </div>
      </section>
    )}

    <!-- REGISTER + APPLY (MEMBER) + REPORT ─────────────────────────── -->
    {showCTASection && (
      <section class="px-4 py-16 md:px-8">
        {ctaThreeCol ? (
          <div class="mx-auto grid max-w-6xl grid-cols-1 gap-6 md:max-w-[90rem] md:grid-cols-3 md:gap-x-10 md:gap-y-4">
            <div class="order-1 flex flex-col gap-4 items-center text-center md:order-none md:items-start md:text-left">
              <h2 class="text-2xl font-black tracking-tight text-white">{join.title}</h2>
              {join.description?.trim() && (
                <p class="text-sm text-white/55">{join.description}</p>
              )}
            </div>
            <div class="order-3 flex flex-col items-center gap-4 text-center md:order-none">
              <h2 class="text-2xl font-black tracking-tight text-white">{joinTeam.sectionTitle}</h2>
              {joinTeam.description && (
                <p class="text-sm text-white/55">{joinTeam.description}</p>
              )}
            </div>
            <div class="order-5 flex flex-col gap-4 items-center text-center md:order-none md:items-end md:text-right">
              <h2 class="text-2xl font-black tracking-tight text-white">{report.sectionTitle}</h2>
              {report.description && (
                <p class="text-sm text-white/55">{report.description}</p>
              )}
            </div>
            <div class="order-2 flex justify-center md:justify-start">
              <a
                href={join.joinUrl!}
                class="inline-flex min-h-[44px] w-fit items-center justify-center rounded-none border-2 border-white px-6 py-3 text-sm font-bold text-white transition hover:bg-white hover:text-black focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-white"
                rel="noopener noreferrer"
              >
                {join.joinButtonLabel}
              </a>
            </div>
            <div class="order-4 flex justify-center">
              <a
                href={joinTeam.url}
                class={joinTeamBtnClass}
                target="_blank"
                rel="noopener noreferrer"
              >
                {joinTeam.buttonLabel}
              </a>
            </div>
            <div class="order-6 flex justify-center md:justify-end">
              <a
                href={report.url}
                class="inline-flex min-h-[44px] w-fit items-center justify-center rounded-none border-2 border-white px-6 py-3 text-sm font-bold text-white transition hover:bg-white hover:text-black focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-white"
                target="_blank"
                rel="noopener noreferrer"
              >
                {report.buttonLabel}
              </a>
            </div>
          </div>
        ) : joinAndReportTwoCol ? (
          <div class="mx-auto grid max-w-6xl grid-cols-1 gap-6 md:grid-cols-2 md:gap-x-16 md:gap-y-4">
            <div class="order-1 flex flex-col gap-4 items-center text-center md:order-none md:items-start md:text-left">
              <h2 class="text-2xl font-black tracking-tight text-white">{join.title}</h2>
              {join.description?.trim() && (
                <p class="text-sm text-white/55">{join.description}</p>
              )}
            </div>
            <div class="order-3 flex flex-col gap-4 items-center text-center md:order-none md:items-end md:text-right">
              <h2 class="text-2xl font-black tracking-tight text-white">{report.sectionTitle}</h2>
              {report.description && (
                <p class="text-sm text-white/55">{report.description}</p>
              )}
            </div>
            <div class="order-2 flex justify-center md:justify-start">
              <a
                href={join.joinUrl!}
                class="inline-flex min-h-[44px] w-fit items-center justify-center rounded-none border-2 border-white px-6 py-3 text-sm font-bold text-white transition hover:bg-white hover:text-black focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-white"
                rel="noopener noreferrer"
              >
                {join.joinButtonLabel}
              </a>
            </div>
            <div class="order-4 flex justify-center md:justify-end">
              <a
                href={report.url}
                class="inline-flex min-h-[44px] w-fit items-center justify-center rounded-none border-2 border-white px-6 py-3 text-sm font-bold text-white transition hover:bg-white hover:text-black focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-white"
                target="_blank"
                rel="noopener noreferrer"
              >
                {report.buttonLabel}
              </a>
            </div>
          </div>
        ) : (
          <div class="mx-auto grid max-w-6xl gap-12">
            {showJoinBlock && showJoinTeam && !showReport && (
              <div class="mx-auto grid w-full max-w-6xl grid-cols-1 gap-6 md:grid-cols-2 md:gap-x-16 md:gap-y-4">
                <div class="order-1 flex flex-col gap-4 items-center text-center md:order-none md:items-start md:text-left">
                  <h2 class="text-2xl font-black tracking-tight text-white">{join.title}</h2>
                  {join.description?.trim() && (
                    <p class="text-sm text-white/55">{join.description}</p>
                  )}
                </div>
                <div class="order-3 flex flex-col items-center gap-4 text-center md:order-none">
                  <h2 class="text-2xl font-black tracking-tight text-white">{joinTeam.sectionTitle}</h2>
                  {joinTeam.description && (
                    <p class="text-sm text-white/55">{joinTeam.description}</p>
                  )}
                </div>
                <div class="order-2 flex justify-center md:justify-start">
                  <a
                    href={join.joinUrl!}
                    class="inline-flex min-h-[44px] w-fit items-center justify-center rounded-none border-2 border-white px-6 py-3 text-sm font-bold text-white transition hover:bg-white hover:text-black focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-white"
                    rel="noopener noreferrer"
                  >
                    {join.joinButtonLabel}
                  </a>
                </div>
                <div class="order-4 flex justify-center">
                  <a
                    href={joinTeam.url}
                    class={joinTeamBtnClass}
                    target="_blank"
                    rel="noopener noreferrer"
                  >
                    {joinTeam.buttonLabel}
                  </a>
                </div>
              </div>
            )}
            {showJoinTeam && showReport && !showJoinBlock && (
              <div class="mx-auto grid w-full max-w-6xl grid-cols-1 gap-6 md:grid-cols-2 md:gap-x-16 md:gap-y-4">
                <div class="order-1 flex flex-col items-center gap-4 text-center md:order-none">
                  <h2 class="text-2xl font-black tracking-tight text-white">{joinTeam.sectionTitle}</h2>
                  {joinTeam.description && (
                    <p class="text-sm text-white/55">{joinTeam.description}</p>
                  )}
                </div>
                <div class="order-3 flex flex-col gap-4 items-center text-center md:order-none md:items-end md:text-right">
                  <h2 class="text-2xl font-black tracking-tight text-white">{report.sectionTitle}</h2>
                  {report.description && (
                    <p class="text-sm text-white/55">{report.description}</p>
                  )}
                </div>
                <div class="order-2 flex justify-center">
                  <a
                    href={joinTeam.url}
                    class={joinTeamBtnClass}
                    target="_blank"
                    rel="noopener noreferrer"
                  >
                    {joinTeam.buttonLabel}
                  </a>
                </div>
                <div class="order-4 flex justify-center md:justify-end">
                  <a
                    href={report.url}
                    class="inline-flex min-h-[44px] w-fit items-center justify-center rounded-none border-2 border-white px-6 py-3 text-sm font-bold text-white transition hover:bg-white hover:text-black focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-white"
                    target="_blank"
                    rel="noopener noreferrer"
                  >
                    {report.buttonLabel}
                  </a>
                </div>
              </div>
            )}
            {showJoinBlock && !showJoinTeam && !showReport && (
              <div class="flex flex-col items-center gap-4 text-center md:items-start md:text-left">
                <h2 class="text-2xl font-black tracking-tight text-white">{join.title}</h2>
                {join.description?.trim() && (
                  <p class="text-sm text-white/55">{join.description}</p>
                )}
                <a
                  href={join.joinUrl!}
                  class="inline-flex min-h-[44px] w-fit items-center justify-center rounded-none border-2 border-white px-6 py-3 text-sm font-bold text-white transition hover:bg-white hover:text-black focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-white"
                  rel="noopener noreferrer"
                >
                  {join.joinButtonLabel}
                </a>
              </div>
            )}
            {showReport && !showJoinBlock && !showJoinTeam && (
              <div class="flex flex-col items-center gap-4 text-center md:items-end md:text-right">
                <h2 class="text-2xl font-black tracking-tight text-white">{report.sectionTitle}</h2>
                {report.description && (
                  <p class="text-sm text-white/55">{report.description}</p>
                )}
                <a
                  href={report.url}
                  class="inline-flex min-h-[44px] w-fit items-center justify-center rounded-none border-2 border-white px-6 py-3 text-sm font-bold text-white transition hover:bg-white hover:text-black focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-white"
                  target="_blank"
                  rel="noopener noreferrer"
                >
                  {report.buttonLabel}
                </a>
              </div>
            )}
            {showJoinTeam && !showJoinBlock && !showReport && (
              <div class="mx-auto flex max-w-lg flex-col items-center gap-4 text-center">
                <h2 class="text-2xl font-black tracking-tight text-white">{joinTeam.sectionTitle}</h2>
                {joinTeam.description && (
                  <p class="text-sm text-white/55">{joinTeam.description}</p>
                )}
                <a
                  href={joinTeam.url}
                  class={joinTeamBtnClass}
                  target="_blank"
                  rel="noopener noreferrer"
                >
                  {joinTeam.buttonLabel}
                </a>
              </div>
            )}
          </div>
        )}
      </section>
    )}

    <!-- FOOTER ─────────────────────────────────────────────────────── -->
    <footer class="border-t border-white/10 px-4 py-5 md:px-8">
      <div class="mx-auto flex max-w-6xl flex-row flex-wrap items-center justify-between gap-x-6 gap-y-2">
        <p class="min-w-0 text-xs text-white/30">{ui.copyrightNotice}</p>
        {(filteredSocialLinks.length > 0 || join.email) && (
          <div class="flex flex-wrap items-center justify-end gap-x-4 gap-y-1">
            {filteredSocialLinks.length > 0 && (
              <ul class="flex flex-wrap items-center gap-2" aria-label={social.sectionTitle}>
                {filteredSocialLinks.map((link) => (
                  <li>
                    <SocialIconLink url={link.url} label={link.label} dark={true} />
                  </li>
                ))}
              </ul>
            )}
            {join.email && (
              <a
                href={`mailto:${join.email}`}
                class="max-w-[min(100%,14rem)] truncate text-xs font-medium text-white/50 underline underline-offset-2 transition hover:text-white/80 sm:max-w-none sm:whitespace-nowrap"
              >
                {join.email}
              </a>
            )}
          </div>
        )}
      </div>
    </footer>

  </div><!-- /dark section -->

</Layout>
