---
import type { SiteData } from "../data/siteData";

interface Props {
  site: SiteData;
}

const { site } = Astro.props;
const { heroStats } = site;
---

<div class="hero-stats pointer-events-auto mx-auto mt-8 w-full sm:mt-10 sm:w-[75%]" data-hero-stats>
  <ul class="grid grid-cols-3 gap-2 sm:gap-0">
    {heroStats.items.map((item) => (
      <li class="flex min-w-0 flex-col items-center px-1 text-center sm:px-6">
        <span class="text-[0.65rem] font-medium leading-tight tracking-wide text-white/60 sm:text-sm">
          {item.label}
        </span>
        <span
          class="hero-stats__value mt-1.5 text-2xl font-semibold tabular-nums leading-none text-white drop-shadow-lg sm:mt-3 sm:text-4xl md:text-5xl"
          aria-hidden="true"
        >
          <span data-count-to={item.value}>0</span>
          {item.suffix && (
            <span class="hero-stats__suffix" data-suffix>{item.suffix}</span>
          )}
        </span>
        <span class="sr-only">{item.value}{item.suffix ?? ""}</span>
      </li>
    ))}
  </ul>
</div>

<style>
  .hero-stats__suffix {
    opacity: 0;
    transition: opacity 0.2s ease;
  }

  .hero-stats__suffix.is-visible {
    opacity: 1;
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-stats__suffix {
      transition: none;
      opacity: 1;
    }
  }
</style>

<script>
  function animateCount(el: HTMLElement, target: number, duration: number, onDone?: () => void) {
    const start = performance.now();
    function tick(now: number) {
      const progress = Math.min((now - start) / duration, 1);
      const eased = 1 - Math.pow(1 - progress, 3);
      el.textContent = String(Math.round(eased * target));
      if (progress < 1) {
        requestAnimationFrame(tick);
      } else {
        onDone?.();
      }
    }
    requestAnimationFrame(tick);
  }

  function initHeroStats() {
    const root = document.querySelector("[data-hero-stats]");
    if (!root) return;

    const values = Array.from(
      root.querySelectorAll<HTMLElement>("[data-count-to]"),
    );
    if (!values.length) return;

    const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

    function run() {
      values.forEach((el) => {
        if (el.dataset.counted === "true") return;
        el.dataset.counted = "true";
        const target = Number(el.dataset.countTo);
        if (!Number.isFinite(target)) return;

        const suffix = el.parentElement?.querySelector<HTMLElement>("[data-suffix]");

        if (reducedMotion) {
          el.textContent = String(target);
          suffix?.classList.add("is-visible");
        } else {
          animateCount(el, target, 1800, () => {
            suffix?.classList.add("is-visible");
          });
        }
      });
    }

    if (reducedMotion) {
      run();
      return;
    }

    const observer = new IntersectionObserver(
      (entries) => {
        if (entries.some((e) => e.isIntersecting)) {
          run();
          observer.disconnect();
        }
      },
      { threshold: 0.3 },
    );
    observer.observe(root);
  }

  initHeroStats();
  document.addEventListener("astro:page-load", initHeroStats);
</script>
