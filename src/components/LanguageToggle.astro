---
import { withBase } from "../utils/withBase";

interface Props {
  lang: "it" | "en";
  label: string;
  /** Optional; use when `label` is abbreviated (e.g. EN / IT). */
  ariaLabel?: string;
  /** Appended to base classes (e.g. drawer layout). */
  extraClass?: string;
}

const { lang, label, ariaLabel, extraClass } = Astro.props;
const baseClass =
  "inline-flex min-h-[40px] min-w-[40px] items-center justify-center rounded-none border border-[rgb(255_4_0)] bg-[rgb(255_4_0)] px-3 py-2 text-xs font-semibold uppercase tracking-wide text-white shadow-sm transition hover:border-[rgb(230_4_0)] hover:bg-[rgb(230_4_0)] focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[rgb(255_4_0)] md:text-sm";
const href = lang === "it" ? withBase("en/") : withBase("");
const hrefLang = lang === "it" ? "en" : "it";
---

<a
  href={href}
  hreflang={hrefLang}
  lang={hrefLang}
  {...ariaLabel ? { "aria-label": ariaLabel } : {}}
  class:list={[baseClass, extraClass]}
>
  {label}
</a>
